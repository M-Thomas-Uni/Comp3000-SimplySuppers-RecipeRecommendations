<style>
#top_recipes_carousel {
    position: relative;
}

#top_recipes_carousel .carousel-control-prev,
#top_recipes_carousel .carousel-control-next {
    width: 5%;          /* narrower hitbox */
    z-index: 5;         /* above recipe cards */
}

#top_recipes_carousel .carousel-control-prev {
    left: -0.75rem;     /* nudge outside border */
}

#top_recipes_carousel .carousel-control-next {
    right: -0.75rem;
}
</style>

<div id="top_recipes_carousel" class="carousel slide border rounded p-3" data-bs-ride="carousel">
    <div class="carousel-inner">
        <% for (let i = 0; i < top_recipes.length; i += 3) { %>
            <div class="carousel-item <%= i == 0 ? 'active' : '' %>">
                <div class="row g-3">
                    <% top_recipes.slice(i, i + 3).forEach( r=> { %>
                        <div class="col-md-4">
                            <%- include('../partials/recipe-card', {recipe: r.recipe}) %>
                        </div>
                    <% }) %>
                </div>
            </div>
        <% } %>
    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#top_recipes_carousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#top_recipes_carousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>



    