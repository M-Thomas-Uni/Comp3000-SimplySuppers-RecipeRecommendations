<div class="recipe-card">

    <h3 class="recipe-card-title">
        <%= recipe.Name %>
    </h3>

    <div class="recipe-card-actions">
        <a href="/similarto/<%= recipe.ID %>" class="recipe-card-button">
            See similar recipes
        </a>

        <div class="recipe-card-categories">
            <p><strong>Category:</strong> <%= recipe.Category %></p>
        </div>

        <div class="recipe-card-keywords">
            <% if (recipe.Keywords.length > 0) { %>
                <p><strong>Keywords:</strong> <%= recipe.Keywords.join(', ') %></p>
            <% } %>
        </div>

        <a href="<%= recipe.URL %>" class="recipe-card-button">
            View full recipe
        </a>
    </div>

</div>
