<div class="recipe-card">

    <h3 class="recipe-card-title">
        <%= recipe.Name %>
    </h3>

    <div class="recipe-card-image">
        <img 
            src="<%= recipe.Image_URL 
                    ? recipe.Image_URL 
                    : '/static/images/placeholder.png' %>" 
            alt="<%= recipe.Name %>"
        >
    </div>

    <div class="recipe-card-actions">
        <a href="/similarto/<%= recipe.ID %>" class="recipe-card-button">
            See similar recipes
        </a>

        <div class="recipe-card-categories">
            <p><strong>Category:</strong> 
                <a href="/top/category/<%= recipe.CategoryID %>">
                    <%= recipe.Category %>
                </a> 
            </p>
        </div>

        <div class="recipe-card-keywords">
            <% if (recipe.Keywords.length > 0) { %>
                <p><strong>Keywords:</strong>
                <% recipe.Keywords.forEach(k => { %>
                    <a href="/top/keyword/<%= k.KeywordID %>" class="keyword-link">
                        <%= k.Name %>
                    </a>
                <% }) %>
                </p>
            <% } %>
        </div>

        <a href="<%= recipe.URL %>" class="recipe-card-button">
            View full recipe
        </a>
    </div>

</div>
